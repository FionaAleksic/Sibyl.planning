{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slotLabels": {
      "type": "array",
      "prefixItems": [
        {
          "const": "Primär"
        },
        {
          "const": "Sekundär"
        },
        {
          "const": "Tertiär"
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "title": "Namen der drei Slots"
    },
    "maxPlanningTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 500,
      "title": "Maximale Planungsvorgänge"
    },
    "useAdRoster": {
      "type": "boolean",
      "default": true,
      "title": "Azubis aus AD beziehen"
    }
  }
}
